{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xiaomao-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // D1：先 `wrangler d1 create xiaomao-sync` 再把返回的 database_id 填这儿
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xiaomao-sync",
      "database_id": "7ad0c836-2789-4fbc-a584-f54a3b407e72"
    }
  ],

  // R2：备份正文（免费额度 10 GB）
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "xiaomao-backups"
    }
  ],

  // JWT_SECRET / CODE_PEPPER / RESEND_API_KEY 一律用 `wrangler secret put`，不写这里
  "vars": {
    "MAIL_FROM": "小耄记账 <no-reply@example.com>"
  }
}
