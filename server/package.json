{
  "name": "xiaomao-sync",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute xiaomao-sync --remote --file schema.sql",
    "db:init:local": "wrangler d1 execute xiaomao-sync --local --file schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
