<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- P6.1（2026-11-10 产品改判）：为「云同步 / 云备份」放行网络权限。
         ⚠️ 这条权限**不是**给后台偷偷上报用的：
          - 不登录 = 不发任何请求（`CloudSyncGate` 在未登录时连 socket 都不建）；
          - 全链路 HTTPS，明文在 `res/xml/network_security_config.xml` 里全局禁掉；
          - 服务器地址写死在 `core/network/sync_endpoints.dart`，不做动态下发。
         改动前的历史：这里曾有「release 包必须剥掉 INTERNET」的不变量（F8.1 为挡 ML Kit
         用量上报而加），P6 起作废 —— 详见 HANDOFF 不变量 #8 的新口径。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- F7.15 自动记账：回执通知（Android 13+ 运行时权限，用户主动开启时才申请）。
         通知监听不需要在这里声明权限 —— 它是 <service> 的 android:permission 属性。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- F7.16：开机后重新排期补抓守护（Android 要求显式声明才能收 BOOT_COMPLETED）。
         属 normal 权限，安装即授予，用户无需任何额外操作。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application
        android:label="小耄记账"
        android:name="${applicationName}"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- F7.15 零权限兜底：从微信/支付宝「分享」一条账单文本到本 App -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- F7.15 自动记账：通知监听服务。
             ⚠️ 三条硬要求，缺一条就「不生效」或「装不上」：
             1. android:permission 必须是 BIND_NOTIFICATION_LISTENER_SERVICE（写在 service 上，
                不是 uses-permission）；
             2. Android 12+ 带 intent-filter 的组件必须显式声明 android:exported；
                本服务由系统绑定，故为 false；
             3. intent-filter 的 action 必须是 android.service.notification.NotificationListenerService -->
        <service
            android:name=".autobook.AutoBookListenerService"
            android:label="小耄记账 · 自动记账"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- F7.16 补抓守护：posted 推送在国产 ROM 上实测不投递（详见 AutoBookGuard 类注释），
             故主防线改为「AlarmManager 周期主动补抓」。BOOT_COMPLETED 让开机后自动续期；
             屏幕亮起也会唤醒一轮 —— 用户亮屏往往就是为了看刚付的款。 -->
        <receiver
            android:name=".autobook.TickReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.teacodeman.yanxin.autobook.TICK" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.SCREEN_ON" />
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
